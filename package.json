{
  "name": "nanoharness",
  "version": "2.0.0",
  "description": "Zero-dependency, provider-agnostic agent harness for small apps: tool loop, guardrails, multi-agent orchestration, workflow graphs and sessions. No network or filesystem code in the core.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./zod": {
      "import": {
        "types": "./dist/zod.d.ts",
        "default": "./dist/zod.js"
      },
      "require": {
        "types": "./dist/zod.d.cts",
        "default": "./dist/zod.cjs"
      }
    },
    "./agents": {
      "import": {
        "types": "./dist/agents.d.ts",
        "default": "./dist/agents.js"
      },
      "require": {
        "types": "./dist/agents.d.cts",
        "default": "./dist/agents.cjs"
      }
    },
    "./graph": {
      "import": {
        "types": "./dist/graph.d.ts",
        "default": "./dist/graph.js"
      },
      "require": {
        "types": "./dist/graph.d.cts",
        "default": "./dist/graph.cjs"
      }
    },
    "./store": {
      "import": {
        "types": "./dist/store.d.ts",
        "default": "./dist/store.js"
      },
      "require": {
        "types": "./dist/store.d.cts",
        "default": "./dist/store.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && npm run test:run",
    "prepublishOnly": "npm run typecheck && npm test",
    "test:run": "node --test test/agent.test.mjs test/guardrails.test.mjs test/orchestration.test.mjs test/audit.test.mjs test/review.test.mjs test/cjs.test.cjs",
    "test:all": "npm run build:all && npm run test:run:all",
    "test:run:all": "npm run test:run && npm run test:run --workspaces",
    "build:all": "npm run build && npm run build --workspaces",
    "typecheck:all": "npm run typecheck && npm run typecheck --workspaces"
  },
  "keywords": [
    "agent",
    "llm",
    "harness",
    "tools",
    "tool-use",
    "zero-dependency",
    "multi-agent",
    "orchestration",
    "workflow",
    "graph",
    "planning",
    "persistence"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "zod": ">=4"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsup": "^9.0.0",
    "typescript": "~5.9",
    "zod": "^4.6.7"
  },
  "author": "buildwithnikhil",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/buildwithnikhil/nanoharness.git"
  },
  "homepage": "https://github.com/buildwithnikhil/nanoharness#readme",
  "bugs": {
    "url": "https://github.com/buildwithnikhil/nanoharness/issues"
  },
  "workspaces": [
    "packages/*"
  ]
}
